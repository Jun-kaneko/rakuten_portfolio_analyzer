# このファイルを .env にコピーし、実際の値を設定してください。
#   cp .env.example .env

# Anthropic APIキー（必須）
ANTHROPIC_API_KEY=your-api-key-here

# 以下は任意設定（未指定時はconfig.pyのデフォルト値を使用）
# CLAUDE_MODEL=claude-sonnet-5
# 保有銘柄数が多い場合、出力が途中で打ち切られることがあるため必要に応じて増やす
# CLAUDE_MAX_TOKENS=8192
# PRICE_FETCH_TIMEOUT=10
# PRICE_FETCH_RETRIES=3
# RETRY_BACKOFF_SECONDS=2.0
# PRICE_CACHE_PATH=price_cache.json
# NEWS_FETCH_TIMEOUT=10
# NEWS_FETCH_RETRIES=3
# NEWS_MAX_ITEMS=3
# NEWS_CACHE_PATH=news_cache.json
# NEWS_FRESHNESS_HOURS=6.0
# おすすめ新規投資候補（web検索併用）の出力トークン上限
# RECOMMEND_MAX_TOKENS=4096
# おすすめ銘柄提案時のweb検索の最大実行回数
# RECOMMEND_WEB_SEARCH_MAX_USES=8
# おすすめする新規投資候補の件数
# RECOMMEND_COUNT=4
# LOG_LEVEL=INFO
